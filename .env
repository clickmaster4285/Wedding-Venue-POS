# Copy this file to `.env` in the project root (same folder as package.json).
# Optional overrides: `.env.local` (also loaded, not committed).
#
# Dev: `npm run dev` — site + POST /api/contact on the same port (default 8080). No proxy.
# Optional: `npm run dev:server` — API only on :3001 for debugging.

# Gmail SMTP (port 587 = STARTTLS → secure is false automatically)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Account that signs in to Gmail (use an App Password, not your normal password)
SMTP_MAIL=software.clickmasters@gmail.com
# 16-character app password; spaces optional (they are stripped)
SMTP_PASSWORD=diqg hpzw ievv nknp

# Shown as the sender in inboxes (must be added under Gmail → Settings → Accounts → Send mail as)
ALIAS_NAME="Sales Team"
ALIAS_EMAIL=sales@clickmasters.pk

# Where contact form notifications are delivered
RECEIVER_EMAIL=software.clickmasters@gmail.com

# Optional fallback if RECEIVER_EMAIL is unset
# MAIL_TO=sales@clickmasters.pk
